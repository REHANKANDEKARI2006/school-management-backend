<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Marksheet / Progress Report Card</title>
    <%- include('../common/theme_variables', { theme: school.document_theme, is_theme_enabled: school.is_document_theme_enabled }) %>
    <style>
        @page {
            size: A4 portrait;
            margin: 12mm 15mm 12mm 15mm;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Segoe UI', 'Arial', sans-serif;
            color: #1e293b;
            background: #ffffff;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
            padding: 10px;
        }

        .ms-container {
            width: 100%;
            min-height: 260mm;
            border: 2px solid var(--primary-color, #1e3a8a);
            padding: 25px 30px;
            background: #ffffff;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        /* ─── HEADER ─── */
        .ms-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 2px solid var(--primary-color, #1e3a8a);
            padding-bottom: 12px;
            margin-bottom: 15px;
        }
        .header-logo {
            width: 65px;
            height: 65px;
            object-fit: contain;
        }
        .header-logo-placeholder {
            width: 65px;
            height: 65px;
            border-radius: 50%;
            background: var(--primary-color, #1e3a8a);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            font-weight: bold;
        }
        .header-info {
            text-align: center;
            flex: 1;
            padding: 0 15px;
        }
        .school-name {
            font-size: 20px;
            font-weight: 800;
            color: var(--primary-color, #1e3a8a);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 3px;
        }
        .school-org {
            font-size: 10px;
            font-weight: 700;
            color: var(--secondary-color, #d97706);
            text-transform: uppercase;
            margin-bottom: 2px;
        }
        .school-address {
            font-size: 10px;
            color: #475569;
            line-height: 1.3;
        }

        /* ─── DOCUMENT TITLE ─── */
        .doc-title-bar {
            text-align: center;
            margin-bottom: 15px;
        }
        .doc-title {
            display: inline-block;
            font-size: 16px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: #ffffff;
            background: var(--primary-color, #1e3a8a);
            padding: 5px 25px;
            border-radius: 20px;
        }

        /* ─── STUDENT INFO GRID ─── */
        .student-info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px 20px;
            background: #f8fafc;
            border: 1px solid var(--border-color, #cbd5e1);
            padding: 12px 18px;
            border-radius: 6px;
            margin-bottom: 20px;
            font-size: 12px;
        }
        .info-row {
            display: flex;
            align-items: baseline;
        }
        .info-label {
            font-weight: 700;
            color: #475569;
            width: 110px;
            flex-shrink: 0;
        }
        .info-colon {
            font-weight: 700;
            color: #94a3b8;
            margin-right: 6px;
        }
        .info-value {
            font-weight: 600;
            color: #0f172a;
            flex: 1;
        }

        /* ─── MARKS TABLE ─── */
        .marks-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
            font-size: 12px;
        }
        .marks-table th, .marks-table td {
            border: 1px solid var(--border-color, #cbd5e1);
            padding: 8px 12px;
            text-align: center;
        }
        .marks-table th {
            background: var(--primary-color, #1e3a8a);
            color: #ffffff;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 11px;
            letter-spacing: 0.5px;
        }
        .marks-table td.subject-cell {
            text-align: left;
            font-weight: 600;
            color: #1e293b;
        }
        .marks-table tr:nth-child(even) {
            background: #f8fafc;
        }

        .status-pass {
            color: #16a34a;
            font-weight: 700;
        }
        .status-fail {
            color: #dc2626;
            font-weight: 700;
        }

        /* ─── SUMMARY BLOCK ─── */
        .summary-box {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #f1f5f9;
            border: 1.5px solid var(--primary-color, #1e3a8a);
            padding: 12px 20px;
            border-radius: 6px;
            margin-bottom: 30px;
            font-size: 13px;
            font-weight: 700;
        }
        .summary-item span {
            color: var(--primary-color, #1e3a8a);
            font-size: 14px;
            margin-left: 4px;
        }
        .result-badge {
            display: inline-block;
            padding: 4px 14px;
            border-radius: 12px;
            font-size: 13px;
            font-weight: 800;
            color: #ffffff;
        }
        .badge-pass { background: #16a34a; }
        .badge-fail { background: #dc2626; }

        /* ─── DUAL SIGNATURES ─── */
        .ms-footer {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            padding: 0 10px;
            margin-top: auto;
        }
        .sig-box {
            text-align: center;
            width: 180px;
        }
        .sig-box img {
            max-height: 40px;
            max-width: 140px;
            object-fit: contain;
            margin-bottom: 4px;
        }
        .sig-line {
            border-top: 1px solid #334155;
            width: 100%;
            margin-bottom: 4px;
        }
        .sig-role {
            font-size: 11px;
            font-weight: 800;
            color: var(--primary-color, #1e3a8a);
            text-transform: uppercase;
        }

        .stamp-center {
            text-align: center;
        }
        .stamp-center img {
            max-height: 65px;
            object-fit: contain;
        }
    </style>
</head>
<body>
<%
    const studentName = ((student.stu_first_name || '') + ' ' + (student.stu_last_name || '')).trim();
    const classSec = (student.class_name || '') + (student.section_name ? ' - ' + student.section_name : '');
    const rollNo = student.roll_number || student.admission_no || student.student_id || '—';
    const logoSrc = school.logo_url || null;
    const sigSrc = school.signature_url || null;
    const stampSrc = school.stamp_url || null;
    const currentExam = (typeof examName !== 'undefined' && examName) ? examName : 'Annual Examination';

    const calcTotalMarks = (typeof totalMarks !== 'undefined') ? Number(totalMarks) : 0;
    const calcMaxTotal = (typeof maxTotal !== 'undefined') ? Number(maxTotal) : 0;
    const calcPct = (typeof percentage !== 'undefined') ? percentage : (calcMaxTotal > 0 ? ((calcTotalMarks / calcMaxTotal) * 100).toFixed(2) : '0.00');

    // Calculate pass status (if all subjects passed or percentage >= 35)
    let isPassed = Number(calcPct) >= 35;
    if (typeof marks !== 'undefined' && Array.isArray(marks) && marks.length > 0) {
        isPassed = marks.every(m => Number(m.obtained_marks || 0) >= (Number(m.max_marks || 100) * 0.33));
    }
%>
<div class="ms-container">
    <div>
        <!-- ─── HEADER ─── -->
        <div class="ms-header">
            <div>
                <% if (logoSrc) { %>
                    <img src="<%= logoSrc %>" class="header-logo" alt="School Logo">
                <% } else { %>
                    <div class="header-logo-placeholder"><%= (school.school_name || 'S').charAt(0) %></div>
                <% } %>
            </div>
            <div class="header-info">
                <% if (school.organization_name) { %>
                    <div class="school-org"><%= school.organization_name %></div>
                <% } %>
                <div class="school-name"><%= school.school_name || 'SCHOOL NAME' %></div>
                <div class="school-address">
                    <%= school.address || '' %>
                    <% if (school.phone) { %> | Tel: <%= school.phone %><% } %>
                    <% if (school.email) { %> | Email: <%= school.email %><% } %>
                </div>
            </div>
            <div style="width: 65px;"></div>
        </div>

        <!-- ─── DOCUMENT TITLE ─── -->
        <div class="doc-title-bar">
            <div class="doc-title">PROGRESS REPORT CARD</div>
        </div>

        <!-- ─── STUDENT INFO GRID ─── -->
        <div class="student-info-grid">
            <div class="info-row">
                <span class="info-label">Student Name</span>
                <span class="info-colon">:</span>
                <span class="info-value"><%= studentName %></span>
            </div>
            <div class="info-row">
                <span class="info-label">Class & Section</span>
                <span class="info-colon">:</span>
                <span class="info-value"><%= classSec %></span>
            </div>
            <div class="info-row">
                <span class="info-label">Student ID / Roll</span>
                <span class="info-colon">:</span>
                <span class="info-value"><%= rollNo %></span>
            </div>
            <div class="info-row">
                <span class="info-label">Academic Session</span>
                <span class="info-colon">:</span>
                <span class="info-value"><%= school.academic_year || '2025-26' %></span>
            </div>
            <div class="info-row">
                <span class="info-label">Father's Name</span>
                <span class="info-colon">:</span>
                <span class="info-value"><%= student.father_name || '—' %></span>
            </div>
            <div class="info-row">
                <span class="info-label">Examination</span>
                <span class="info-colon">:</span>
                <span class="info-value"><%= currentExam %></span>
            </div>
        </div>

        <!-- ─── MARKS TABLE ─── -->
        <table class="marks-table">
            <thead>
                <tr>
                    <th style="width: 45%; text-align: left;">Subject</th>
                    <th style="width: 15%;">Max Marks</th>
                    <th style="width: 15%;">Marks Obtained</th>
                    <th style="width: 10%;">Grade</th>
                    <th style="width: 15%;">Status</th>
                </tr>
            </thead>
            <tbody>
                <% if (typeof marks !== 'undefined' && Array.isArray(marks) && marks.length > 0) { %>
                    <% marks.forEach(m => { 
                        const obt = Number(m.obtained_marks || 0);
                        const max = Number(m.max_marks || 100);
                        const subPassed = obt >= (max * 0.33);
                    %>
                        <tr>
                            <td class="subject-cell"><%= m.subject_name %></td>
                            <td><%= max %></td>
                            <td><%= obt %></td>
                            <td><strong><%= m.grade || (subPassed ? 'A' : 'F') %></strong></td>
                            <td class="<%= subPassed ? 'status-pass' : 'status-fail' %>">
                                <%= subPassed ? 'PASS' : 'FAIL' %>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="5" style="padding: 20px; color: #94a3b8; font-style: italic;">
                            No examination marks records found for this student.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>

        <!-- ─── SUMMARY BLOCK ─── -->
        <div class="summary-box">
            <div class="summary-item">Total Marks: <span><%= calcTotalMarks %> / <%= calcMaxTotal %></span></div>
            <div class="summary-item">Percentage: <span><%= calcPct %>%</span></div>
            <div>
                Result: 
                <span class="result-badge <%= isPassed ? 'badge-pass' : 'badge-fail' %>">
                    <%= isPassed ? 'PASSED & PROMOTED' : 'NEEDS IMPROVEMENT' %>
                </span>
            </div>
        </div>
    </div>

    <!-- ─── DUAL SIGNATURE FOOTER ─── -->
    <div class="ms-footer">
        <div class="sig-box">
            <div style="height: 40px;"></div>
            <div class="sig-line"></div>
            <div class="sig-role">CLASS TEACHER</div>
        </div>

        <% if (stampSrc) { %>
            <div class="stamp-center">
                <img src="<%= stampSrc %>" alt="Stamp">
            </div>
        <% } %>

        <div class="sig-box">
            <% if (sigSrc) { %>
                <img src="<%= sigSrc %>" alt="Principal Signature">
            <% } else { %>
                <div style="height: 40px;"></div>
            <% } %>
            <div class="sig-line"></div>
            <div class="sig-role">PRINCIPAL / DIRECTOR</div>
        </div>
    </div>
</div>
</body>
</html>
