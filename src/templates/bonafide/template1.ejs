<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Bonafide Certificate</title>
    <%- include('../common/theme_variables', { theme: school.document_theme, is_theme_enabled: school.is_document_theme_enabled }) %>
    <style>
        @page {
            size: A4 portrait;
            margin: 15mm 20mm 15mm 20mm; /* Suitable for letterhead or blank A4 printing */
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Segoe UI', 'Arial', sans-serif;
            color: #1e293b;
            background: #ffffff;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
            padding: 10px;
        }

        .cert-container {
            width: 100%;
            min-height: 260mm;
            border: 2px solid var(--primary-color, #1e3a8a);
            padding: 30px 40px;
            position: relative;
            background: #ffffff;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        /* Inner border frame */
        .cert-inner-frame {
            border: 1px solid var(--border-color, #cbd5e1);
            padding: 25px 35px;
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        /* ─── HEADER ─── */
        .cert-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 2px solid var(--primary-color, #1e3a8a);
            padding-bottom: 15px;
            margin-bottom: 20px;
        }
        .header-logo {
            width: 70px;
            height: 70px;
            object-fit: contain;
        }
        .header-logo-placeholder {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            background: var(--primary-color, #1e3a8a);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            font-weight: bold;
        }
        .header-info {
            text-align: center;
            flex: 1;
            padding: 0 15px;
        }
        .school-name {
            font-size: 22px;
            font-weight: 800;
            color: var(--primary-color, #1e3a8a);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }
        .school-org {
            font-size: 11px;
            font-weight: 700;
            color: var(--secondary-color, #d97706);
            text-transform: uppercase;
            margin-bottom: 3px;
        }
        .school-address {
            font-size: 11px;
            color: #475569;
            line-height: 1.3;
        }
        .school-affiliation {
            font-size: 10px;
            color: #64748b;
            font-style: italic;
            margin-top: 2px;
        }

        /* ─── META ROW (Ref & Date) ─── */
        .meta-row {
            display: flex;
            justify-content: space-between;
            font-size: 12px;
            font-weight: 600;
            color: #334155;
            margin-bottom: 25px;
            padding: 0 5px;
        }

        /* ─── TITLE ─── */
        .cert-title-container {
            text-align: center;
            margin-bottom: 30px;
        }
        .cert-title {
            display: inline-block;
            font-size: 20px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--primary-color, #1e3a8a);
            border-bottom: 2px solid var(--secondary-color, #d97706);
            padding-bottom: 4px;
        }

        /* ─── BODY ─── */
        .cert-body {
            font-size: 14px;
            line-height: 2.1;
            color: #1e293b;
            text-align: justify;
            margin-bottom: 40px;
            padding: 0 10px;
        }
        .highlight {
            font-weight: 700;
            color: var(--primary-color, #1e3a8a);
            border-bottom: 1px dashed var(--primary-color, #1e3a8a);
            padding: 0 4px;
        }

        /* ─── FOOTER & SIGNATURES ─── */
        .cert-footer {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-top: 30px;
            padding: 0 10px;
        }
        .seal-box {
            text-align: center;
            width: 100px;
        }
        .seal-box img {
            max-height: 80px;
            max-width: 80px;
            object-fit: contain;
        }
        .seal-placeholder {
            width: 80px;
            height: 80px;
            border: 2px dashed #cbd5e1;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            font-weight: 700;
            color: #94a3b8;
            margin: 0 auto;
        }

        .sig-box {
            text-align: center;
            min-width: 160px;
        }
        .sig-box img {
            max-height: 45px;
            max-width: 140px;
            object-fit: contain;
            margin-bottom: 4px;
        }
        .sig-line {
            border-top: 1px solid #334155;
            width: 100%;
            margin-bottom: 4px;
        }
        .sig-role {
            font-size: 12px;
            font-weight: 800;
            color: var(--primary-color, #1e3a8a);
            text-transform: uppercase;
        }
        .sig-name {
            font-size: 10px;
            color: #64748b;
        }
    </style>
</head>
<body>
<%
    const studentName = ((student.stu_first_name || '') + ' ' + (student.stu_last_name || '')).trim();
    const fatherName = student.father_name || student.mother_name || '________________';
    const classSec = (student.class_name || '') + (student.section_name ? ' - ' + student.section_name : '');
    const dobFormatted = student.date_of_birth ? new Date(student.date_of_birth).toLocaleDateString('en-GB', {day: '2-digit', month: '2-digit', year: 'numeric'}) : '________________';
    const issueDate = new Date().toLocaleDateString('en-GB', {day: '2-digit', month: '2-digit', year: 'numeric'});
    const refNo = `BON/${new Date().getFullYear()}/${String(student.student_id).padStart(4, '0')}`;
    const logoSrc = logoUrl || school.logo_url || null;
    const sigSrc = signatureUrl || school.signature_url || null;
    const stampSrc = school.stamp_url || null;
%>
<div class="cert-container">
    <div class="cert-inner-frame">

        <!-- ─── HEADER ─── -->
        <div>
            <div class="cert-header">
                <div>
                    <% if (logoSrc) { %>
                        <img src="<%= logoSrc %>" class="header-logo" alt="School Logo">
                    <% } else { %>
                        <div class="header-logo-placeholder"><%= (school.school_name || 'S').charAt(0) %></div>
                    <% } %>
                </div>
                <div class="header-info">
                    <% if (school.organization_name) { %>
                        <div class="school-org"><%= school.organization_name %></div>
                    <% } %>
                    <div class="school-name"><%= school.school_name || 'SCHOOL NAME' %></div>
                    <div class="school-address">
                        <%= school.address || '' %>
                        <% if (school.phone) { %> | Tel: <%= school.phone %><% } %>
                        <% if (school.email) { %> | Email: <%= school.email %><% } %>
                    </div>
                    <% if (school.accreditation_line || school.affiliation_number) { %>
                        <div class="school-affiliation">
                            <%= school.accreditation_line || '' %>
                            <% if (school.affiliation_number) { %> (Affiliation No: <%= school.affiliation_number %>)<% } %>
                        </div>
                    <% } %>
                </div>
                <div style="width: 70px;"></div> <!-- Spacer for header symmetry -->
            </div>

            <!-- ─── META ROW ─── -->
            <div class="meta-row">
                <div>Ref No: <strong><%= refNo %></strong></div>
                <div>Date: <strong><%= issueDate %></strong></div>
            </div>

            <!-- ─── TITLE ─── -->
            <div class="cert-title-container">
                <div class="cert-title">
                    <%= (typeof customTitle !== 'undefined' && customTitle) ? customTitle : 'BONAFIDE CERTIFICATE' %>
                </div>
            </div>

            <!-- ─── BODY ─── -->
            <div class="cert-body">
                <% if (typeof customParagraph !== 'undefined' && customParagraph) { %>
                    <div style="white-space: pre-wrap;"><%- customParagraph %></div>
                <% } else { %>
                    <p>
                        This is to certify that Master / Ms. <span class="highlight"><%= studentName %></span>, 
                        son / daughter of <span class="highlight"><%= fatherName %></span>, 
                        bearing Roll No / ID <span class="highlight"><%= student.admission_no || student.student_id %></span>, 
                        is a bonafide student of this institution.
                    </p>
                    <p>
                        He / She is currently enrolled in <span class="highlight">Class <%= classSec %></span> 
                        for the academic session <span class="highlight"><%= school.academic_year || '2025-26' %></span>. 
                        According to the official records of the school, his / her date of birth is 
                        <span class="highlight"><%= dobFormatted %></span>.
                    </p>
                    <p>
                        This certificate is issued upon request of the student for official / administrative purposes. 
                        To the best of our knowledge and belief, he / she bears good moral character and conduct.
                    </p>
                <% } %>

                <% if (typeof customRemarks !== 'undefined' && customRemarks) { %>
                    <div style="margin-top: 15px; font-style: italic; color: #475569;">
                        <strong>Remarks:</strong> <%= customRemarks %>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- ─── FOOTER & SIGNATURES ─── -->
        <div class="cert-footer">
            <div class="seal-box">
                <% if (stampSrc) { %>
                    <img src="<%= stampSrc %>" alt="Official Seal">
                <% } else { %>
                    <div class="seal-placeholder">OFFICIAL<br>STAMP</div>
                <% } %>
            </div>

            <div class="sig-box">
                <% if (sigSrc) { %>
                    <img src="<%= sigSrc %>" alt="Signature">
                <% } else { %>
                    <div style="height: 45px;"></div>
                <% } %>
                <div class="sig-line"></div>
                <div class="sig-role">PRINCIPAL / DIRECTOR</div>
                <div class="sig-name"><%= school.principal_name || 'Authorized Signatory' %></div>
            </div>
        </div>

    </div>
</div>
</body>
</html>
