DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

JWT_SECRET=super_secret_access_key_123
JWT_REFRESH_SECRET=super_secret_refresh_key_456

ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=2h

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Brevo HTTP API Key (Primary Email Service)
BREVO_API_KEY=your_brevo_api_v3_key

# Email SMTP Settings (Fallback Transport)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="SchoolOS <your_email@gmail.com>"

# Frontend URL used in email links
FRONTEND_URL=https://your-frontend-domain.vercel.app
